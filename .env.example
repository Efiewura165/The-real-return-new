# Public site URL (no trailing slash), e.g. https://therealreturn.com. Used for
# canonical links, social share cards, the sitemap, and structured data. On Vercel
# it falls back to the production URL automatically if unset.
NEXT_PUBLIC_SITE_URL=

# Supabase (leads database + admin auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (transactional email)
RESEND_API_KEY=

# Internal notifications: where new leads/reservations get emailed
RESERVE_NOTIFY_EMAIL=

# Sanity CMS (see docs/cms-migration-roadmap.md)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
SANITY_API_WRITE_TOKEN=

# PayPal (deposit checkout on /reserve). Without these, DepositCheckout
# falls back to inquiry-only — the site still works, just without online
# payment. Get client ID/secret from https://developer.paypal.com/dashboard/applications
# (use a Sandbox app for testing, a Live app for real charges).
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
RESERVATION_DEPOSIT_AMOUNT=500.00
